# ---- Build outputs ----
build/
cmake-build-*/

# ---- Python (tools/*.py 运行后产生的缓存) ----
__pycache__/
*.py[cod]

# ---- IDE / editor ----
.idea/
# 只放行 settings.json 和 tasks.json: 前者记录实测可用的 cmake/ninja 路径,
# 后者是 Ctrl+Shift+B 一键编译(自动生成 .bin/.hex)的入口,
# 都属于环境可复现性证据(系统 PATH 里的 C:\ST\STM32CubeCLT_1.21.0 是卸载残留死路径)。
# 其余 .vscode/ 下的文件都是个人偏好, 不跟踪。
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
*.uvguix.*
*.uvoptx
*.ioc.bak

# ---- CMake ----
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json

# ---- Toolchain artifacts ----
*.o
*.d
*.crf
*.dep
*.axf
*.elf
*.bin
*.hex
*.map
*.lst
*.sct
*.scvd
*.iex
*.htm

# ---- OS / misc ----
Thumbs.db
Desktop.ini
.DS_Store
*.bak
*.orig
*.rej
