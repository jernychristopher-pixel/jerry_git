                "env": {
                    "PATH": "C:/Users/jerny/AppData/Local/stm32cube/bundles/ninja/1.13.1+st.1/bin;C:/Users/jerny/AppData/Local/stm32cube/bundles/gnu-tools-for-stm32/14.3.1+st.2/bin;${env:PATH}"
                }
            },
            "dependsOn": "STM32: Configure Release",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "STM32: Configure Release",
            "type": "shell",
            "command": "C:/Users/jerny/AppData/Local/stm32cube/bundles/cmake/4.0.1+st.3/bin/cmake.exe",
            "args": [
                "--preset",
                "Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "C:/Users/jerny/AppData/Local/stm32cube/bundles/ninja/1.13.1+st.1/bin;C:/Users/jerny/AppData/Local/stm32cube/bundles/gnu-tools-for-stm32/14.3.1+st.2/bin;${env:PATH}"
