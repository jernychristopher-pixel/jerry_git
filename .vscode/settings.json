    "cmake.environment": {
        "PATH": "C:/Users/jerny/AppData/Local/stm32cube/bundles/ninja/1.13.1+st.1/bin;C:/Users/jerny/.vscode/extensions/stmicroelectronics.stm32cube-ide-core-1.4.0-win32-x64/resources/binaries/win32/x86_64;C:/Users/jerny/.vscode/extensions/stmicroelectronics.stm32cube-ide-build-cmake-1.46.0-win32-x64/resources/cube-cmake/win32/x86_64;${env.PATH}"
    }
}
